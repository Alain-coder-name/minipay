<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===== ULTRA COMPACT MODERN HEADER ===== -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/header_gradient"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/welcomeText"
                            android:text="Hi, John! 👋"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Good Morning"
                            android:textSize="12sp"
                            android:textColor="@color/text_teal_light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Notification Icon -->
                    <TextView
                        android:text="🔔"
                        android:textSize="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <!-- Balance Card (Bank Card Style) -->
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/balance_card_bg"
                    android:elevation="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Card Header: Chip and Brand -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:text="🎛️"
                            android:textSize="28sp"
                            android:layout_alignParentStart="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="MiniPay"
                            android:textColor="@color/text_white"
                            android:textStyle="italic|bold"
                            android:textSize="16sp"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>

                    <TextView
                        android:text="Total Balance"
                        android:textSize="12sp"
                        android:textColor="@color/text_teal_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/balanceText"
                        android:text="₹12,500.00"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Phone Number / Card Number -->
                    <TextView
                        android:id="@+id/cardNumberText"
                        android:text="+91 98765 00000"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Send / Receive Buttons (Modern Rounded Style) -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sendBtn"
                            android:text="✈ Send"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:backgroundTint="@color/white_transparent"
                            app:cornerRadius="24dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/receiveBtn"
                            android:text="⬇ Req/Receive"
                            android:textColor="@color/teal_primary"
                            android:textSize="13sp"
                            android:backgroundTint="@color/white"
                            app:cornerRadius="24dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"/>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Quick Actions / Highlights Row -->
            <LinearLayout
                android:orientation="horizontal"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="📷 Scan"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/teal_primary"
                    android:textSize="13sp"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/topUpBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="➕ Top Up"
                    android:textColor="@color/teal_primary"
                    android:textSize="13sp"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="📋 History"
                    android:textColor="@color/teal_primary"
                    android:textSize="13sp"
                    app:cornerRadius="16dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"/>
            </LinearLayout>

            <!-- ===== RECENT TRANSACTIONS ===== -->
            <TextView
                android:text="Recent Transactions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Transaction List Container -->
            <LinearLayout
                android:id="@+id/recentTransactionContainer"
                android:orientation="vertical"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_bg"
                android:elevation="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

    <!-- ===== FLOATING MODERN BOTTOM NAVIGATION ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/nav_bg"
        android:elevation="12dp"
        app:itemIconTint="@color/nav_icon_color"
        app:itemTextColor="@color/nav_icon_color"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_menu"/>

</RelativeLayout>