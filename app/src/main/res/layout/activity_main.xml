<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== MODERN MINIMALIST HEADER ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="80dp"
            android:paddingBottom="60dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/header_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <TextView
                android:text="MiniPay"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:letterSpacing="0.05"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="The Future of Finance"
                android:textSize="14sp"
                android:textColor="@color/text_teal_light"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Form Card (Floating Island Style) -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_marginTop="-40dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/card_bg"
            android:elevation="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Welcome Back"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Sign in to your secure account"
                android:textSize="14sp"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="32dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Email Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="20dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidthFocused="2dp"
                android:hint="Email Address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidthFocused="2dp"
                android:hint="Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:textColor="@color/text_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/forgotPassword"
                android:text="Forgot Password?"
                android:textColor="@color/teal_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="32dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Login Button (Modern Pill Shape) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginBtn"
                android:text="Sign In"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/teal_primary"
                app:cornerRadius="28dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:elevation="4dp"/>

            <!-- Divider -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View android:layout_weight="1" android:layout_width="0dp" android:layout_height="1dp" android:background="@color/divider"/>
                <TextView android:text="  OR  " android:textColor="@color/text_gray" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <View android:layout_weight="1" android:layout_width="0dp" android:layout_height="1dp" android:background="@color/divider"/>
            </LinearLayout>

            <!-- Register Button (Modern Tonal Style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="Create Account"
                android:textColor="@color/teal_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
